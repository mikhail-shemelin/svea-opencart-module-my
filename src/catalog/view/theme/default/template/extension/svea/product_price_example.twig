<div class="svea-product-price__example">
    <h3>{{ text_example_title }}</h3>
    <dl class="svea-product-price__facts">
        <div><dt>{{ text_credit_amount }}</dt><dd>{{ amount }} {{ currency }}</dd></div>
        <div><dt>{{ text_campaign }}</dt><dd>{{ campaign_description }}</dd></div>
        <div><dt>{{ text_term }}</dt><dd>{{ contract_length }} {{ text_months }}</dd></div>
        <div><dt>{{ text_frequency }}</dt><dd>{{ text_monthly }}</dd></div>
        <div><dt>{{ text_interest }}</dt><dd>{{ interest_rate }} % ({{ text_variable }})</dd></div>
        <div><dt>{{ text_initial_fee }}</dt><dd>{{ initial_fee }} {{ currency }}</dd></div>
        <div><dt>{{ text_notification_fee }}</dt><dd>{{ notification_fee }} {{ currency }}</dd></div>
        <div><dt>{{ text_average_monthly }}</dt><dd>{{ monthly_amount }} {{ currency }}</dd></div>
        <div><dt>{{ text_total }}</dt><dd>{{ total_amount }} {{ currency }}</dd></div>
        <div><dt>{{ text_effective_interest }}</dt><dd>{{ effective_interest }} %</dd></div>
    </dl>
    {{ credit_warning }}
</div>
