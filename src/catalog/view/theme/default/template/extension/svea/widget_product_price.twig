<div class="svea-product-price" data-svea-product-price data-product-id="{{ product_id }}" data-currency="{{ currency }}" data-calculation-url="{{ calculation_url }}" data-loading-text="{{ text_loading }}" data-error-text="{{ text_error }}" data-unavailable-text="{{ text_unavailable }}" data-retry-text="{{ text_retry }}">
    <button type="button" class="svea-product-price__trigger" aria-controls="svea-product-price-dialog-{{ product_id }}" aria-expanded="false" aria-label="{{ text_information }}">
        <svg class="svea-product-price__logo" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2540 930" focusable="false">
            <path d="M403 256l-172 0c-62,0 -70,-31 -70,-55 0,-49 25,-69 88,-69l334 0 0 -135 -353 0c-157,0 -230,64 -230,202 0,130 69,190 219,190l154 0c60,0 80,14 80,59 0,37 -14,57 -89,57l-338 0 0 135 359 0c156,0 229,-63 229,-198 0,-133 -61,-187 -210,-187z" />
            <polygon points="1137,-3 955,438 777,-3 602,-3 883,641 1034,641 1303,-3" />
            <path d="M1572 129l226 0 0 -133 -229 0c-207,0 -304,106 -304,333 0,117 33,200 100,254 66,53 130,57 201,57l232 0 0 -133 -226 0c-94,0 -131,-35 -135,-127l361 0 0 -133 -360 0c8,-81 51,-119 133,-119z" />
            <path d="M2097 358l73 -191 76 191 -149 0zm1 -361l-273 644 165 0 55 -148 252 0 57 148 172 0 -275 -644 -154 0z" />
            <path class="svea-product-price__logo-underline" d="M2496 931l-2445 0c-17,0 -31,-14 -31,-31l0 -106c0,-17 14,-31 31,-31l2445 0c17,0 31,14 31,31l0 106c0,17 -14,31 -31,31z" />
        </svg>
        <span class="svea-product-price__trigger-text">{{ text_trigger }}</span>
        <span class="svea-product-price__info" aria-hidden="true">i</span>
    </button>
    <section id="svea-product-price-dialog-{{ product_id }}" class="svea-product-price__dialog" role="dialog" aria-labelledby="svea-product-price-title-{{ product_id }}" hidden>
        <div class="svea-product-price__dialog-header">
            <h2 id="svea-product-price-title-{{ product_id }}">{{ text_dialog_title }}</h2>
            <button type="button" class="svea-product-price__close" aria-label="{{ text_close }}">&times;</button>
        </div>
        <div class="svea-product-price__body" aria-live="polite">
            <div class="svea-product-price__state svea-product-price__state--loading" role="status">
                <span class="svea-product-price__spinner" aria-hidden="true"></span>
                <span>{{ text_loading }}</span>
            </div>
        </div>
    </section>
</div>
